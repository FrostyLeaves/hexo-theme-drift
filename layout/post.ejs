<%
const showToc = theme.post && theme.post.toc && page.toc !== false;
const licenseLinks = (theme.post && theme.post.license_links) || {};
const licenseUrl = page.license ? licenseLinks[page.license] : null;
%>
<article class="post-layout<%= showToc ? ' has-toc' : '' %>" itemscope itemtype="https://schema.org/BlogPosting">
  <div class="post container">
    <header class="post-header">
      <h1 class="post-title px title-anim" itemprop="headline" aria-label="<%= page.title %>"><%- letter_spans(page.title, 'ch') %></h1>
      <%- partial('_partial/post-meta', { post: page, full: true }) %>
    </header>

    <% if (showToc) { %>
    <details class="toc-mobile panel">
      <summary class="px"><%= __('post.toc') %></summary>
      <%- partial('_partial/toc') %>
    </details>
    <% } %>

    <div class="post-body panel">
      <div class="post-content" itemprop="articleBody">
        <%- page.content %>
      </div>
      <% if (page.license) { %>
        <p class="post-license">
          <%= __('post.license_prefix') %>
          <% if (licenseUrl) { %><a href="<%= licenseUrl %>" target="_blank" rel="license noopener"><%= page.license %></a><% } else { %><%= page.license %><% } %>
          <%= __('post.license_suffix') %>
        </p>
      <% } %>
    </div>

    <footer class="post-footer">
      <% if (page.tags && page.tags.length) { %>
        <div class="post-tags">
          <% page.tags.forEach(function (tag) { %>
            <a class="chip px" href="<%- url_for(tag.path) %>">#<%= tag.name %></a>
          <% }); %>
        </div>
      <% } %>
      <% if (page.prev || page.next) { %>
      <nav class="post-nav" aria-label="<%= __('post.prev') %> / <%= __('post.next') %>">
        <% if (page.prev) { %>
          <a class="post-nav__item post-nav__prev card" data-tilt href="<%- url_for(page.prev.path) %>">
            <span class="card__inner">
              <span class="post-nav__label px"><%= __('post.prev') %> · <%= date(page.prev.date, 'YYYY-MM-DD') %></span>
              <span class="post-nav__title"><%= page.prev.title %></span>
              <span class="card__foil" aria-hidden="true"></span>
            </span>
          </a>
        <% } else { %><span></span><% } %>
        <% if (page.next) { %>
          <a class="post-nav__item post-nav__next card" data-tilt href="<%- url_for(page.next.path) %>">
            <span class="card__inner">
              <span class="post-nav__label px"><%= __('post.next') %> · <%= date(page.next.date, 'YYYY-MM-DD') %></span>
              <span class="post-nav__title"><%= page.next.title %></span>
              <span class="card__foil" aria-hidden="true"></span>
            </span>
          </a>
        <% } %>
      </nav>
      <% } %>
    </footer>

    <%- partial('_partial/comments') %>
  </div>

  <% if (showToc) { %>
  <aside class="post-aside">
    <%- partial('_partial/toc') %>
  </aside>
  <% } %>
</article>
