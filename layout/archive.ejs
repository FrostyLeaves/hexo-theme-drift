<%
let title = ui_label('archive.title');
const translateTitle = !is_category() && !is_tag();
if (is_category()) title = page.category;
else if (is_tag()) title = page.tag;
const list = page.posts && page.posts.toArray ? page.posts.toArray() : (page.posts || []);
const total = (page.posts && typeof page.posts.length === 'number') ? page.posts.length : list.length;
const years = {};
list.forEach(function (post) {
  const y = post.date.year();
  (years[y] = years[y] || []).push(post);
});
const yearKeys = Object.keys(years).sort(function (a, b) { return b - a; });
%>
<div class="container archive">
  <header class="page-header">
    <h1 class="px title-anim"<% if (translateTitle) { %> data-i18n-aria-label="archive.title"<% } %> aria-label="<%= title %>"><%- translateTitle ? ui_text('archive.title', 'ch') : letter_spans(title, 'ch') %></h1>
    <span class="badge badge--blue px"><%- ui_text('archive.total_prefix') %> <%= total %> <%- ui_text('archive.total_suffix') %></span>
  </header>
  <% yearKeys.forEach(function (year) { %>
  <section class="archive-year panel">
    <h2 class="archive-year__title px"><%= year %></h2>
    <ul class="archive-list">
      <% years[year].forEach(function (post) { %>
      <li class="archive-item">
        <time class="px" datetime="<%= date_xml(post.date) %>"><%= date(post.date, 'MM-DD') %></time>
        <a href="<%- url_for(post.path) %>"><%= post.title %></a>
      </li>
      <% }); %>
    </ul>
  </section>
  <% }); %>
  <%- partial('_partial/pagination') %>
</div>
