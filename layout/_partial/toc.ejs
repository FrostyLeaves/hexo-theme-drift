<%
const tocHtml = toc(page.content, {
  class: 'toc-list',
  list_number: false,
  min_depth: 2,
  max_depth: (theme.post && theme.post.toc_max_depth) || 3
});
%>
<% if (tocHtml) { %>
<nav class="toc panel" aria-label="<%= __('post.toc') %>">
  <div class="toc__title px"><%= __('post.toc') %></div>
  <%- tocHtml %>
</nav>
<% } %>
